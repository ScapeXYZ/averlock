+func TestNewClientRedisURL(t *testing.T) {
+	c, err := NewClientFromAddress("rediss://default:password@redis.example:6380/3")
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, c.Close()) })
+
+	opts := c.Options()
+	require.Equal(t, "redis.example:6380", opts.Addr)
+	require.Equal(t, "default", opts.Username)
+	require.Equal(t, "password", opts.Password)
+	require.Equal(t, 3, opts.DB)
+	require.NotNil(t, opts.TLSConfig)
+}
+
+func TestNewClientHostPortFallback(t *testing.T) {
+	c, err := NewClientFromAddress("127.0.0.1:6379")
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, c.Close()) })
+
+	opts := c.Options()
+	require.Equal(t, "127.0.0.1:6379", opts.Addr)
+	require.Empty(t, opts.Username)
+	require.Empty(t, opts.Password)
+}
+
+func TestNewClientInvalidRedisURLDoesNotLeakCredentials(t *testing.T) {
+	const password = "redis-secret-must-not-appear"
+	_, err := NewClientFromAddress("redis://default:" + password + "@redis.example:6379/not-a-database")
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "invalid Redis URL")
+	require.NotContains(t, err.Error(), password)
+	require.False(t, strings.Contains(err.Error(), "default:"))
+}
