+// NewClientFromAddress creates a Redis client connected to a host:port or Redis URL.
+// Redis URLs support credentials, database selection, and TLS (rediss://).
+func NewClientFromAddress(address string) (*redis.Client, error) {
+	if strings.HasPrefix(address, "redis://") || strings.HasPrefix(address, "rediss://") {
+		opts, err := redis.ParseURL(address)
+		if err != nil {
+			// Do not return the parser error: it may contain the URL, including credentials.
+			return nil, errors.New("invalid Redis URL")
+		}
+		return redis.NewClient(opts), nil
+	}
+
+	return NewClient(address), nil
 }
 
