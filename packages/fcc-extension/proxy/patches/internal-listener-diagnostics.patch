+// internalRequestDiagnostics logs lifecycle boundaries for the node-facing
+// endpoints without recording request bodies, headers, query values, or IDs.
+func internalRequestDiagnostics(endpoint func(*http.Request) string, next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		start := time.Now()
+		name := endpoint(r)
+		logger.Infof("internal request enter endpoint=%s method=%s", name, r.Method)
+		rec := &statusRecorder{ResponseWriter: w, status: http.StatusOK}
+		defer func() {
+			logger.Infof("internal request exit endpoint=%s method=%s status=%d duration=%s", name, r.Method, rec.status, time.Since(start))
+		}()
+		next.ServeHTTP(rec, r)
+	})
+}
+
+func resultEndpoint(*http.Request) string { return "/result" }
+
+// queueEndpoint only reports known endpoint names. It never logs arbitrary
+// request data in the invalid-queue case.
+func queueEndpoint(r *http.Request) string {
+	switch processorutils.QueueID(r.PathValue("queueID")) {
+	case processorutils.Direct:
+		return "/queue/direct"
+	case processorutils.Main:
+		return "/queue/main"
+	case processorutils.Backup:
+		return "/queue/backup"
+	default:
+		return "/queue/invalid"
+	}
+}
+
