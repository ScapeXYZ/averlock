+var expectedAverlockExtensionID = common.HexToHash("0x010187")
+
+// logDecodedInfo reports only public identity and structural fields. It deliberately
+// excludes signatures, attestation tokens, result data, and key coordinates.
+func logDecodedInfo(result *types.TeeInfoResponse, challenge common.Hash, cfg *attestation.Config) {
+	expectedChainID := uint64(0)
+	if cfg != nil {
+		expectedChainID = cfg.ChainID
+	}
+	logger.Infof("TEE_INFO decoded: extension_id=%s expected_extension_id=%s extension_id_match=%t chain_id=%d expected_chain_id=%d chain_id_match=%t challenge_match=%t machine_public_key_match=%t system_state=%x system_state_version=%s machine_state=%x machine_state_version=%s attestation_kind=%s data_signature_bytes=%d",
+		result.MachineData.ExtensionID,
+		expectedAverlockExtensionID,
+		result.MachineData.ExtensionID == expectedAverlockExtensionID,
+		result.TeeInfo.ChainID,
+		expectedChainID,
+		expectedChainID == 0 || result.TeeInfo.ChainID == expectedChainID,
+		result.TeeInfo.Challenge == challenge,
+		result.TeeInfo.PublicKey == result.MachineData.PublicKey,
+		[]byte(result.TeeInfo.State.SystemState),
+		result.TeeInfo.State.SystemStateVersion,
+		[]byte(result.TeeInfo.State.State),
+		result.TeeInfo.State.StateVersion,
+		attestationKind(result.Attestation),
+		len(result.DataSignature),
+	)
+}
+
+func attestationKind(value string) string {
+	if value == "magic_pass" {
+		return "simulated_magic_pass"
+	}
+	if value == "" {
+		return "empty"
+	}
+	return "token_present"
+}
