 // PrivateKeyFromEnv extracts ecdsa private key from env variable.
 //
 // Private key should be 32 bytes long hex string, but it can be shorter. It can be 0x or 0X prefixed or not.
+func PrivateKey(variableName string, chainID uint64) (*ecdsa.PrivateKey, error) {
+	mode := strings.ToLower(strings.TrimSpace(os.Getenv("PROXY_SIGNER_MODE")))
+	switch mode {
+	case "keystore":
+		return privateKeyFromKeystore(chainID)
+	case "raw", "":
+		return PrivateKeyFromEnv(variableName)
+	default:
+		return nil, fmt.Errorf("unsupported PROXY_SIGNER_MODE %q (must be keystore or raw)", mode)
+	}
+}
