# Disposable XRPL Testnet credentials only. Never use mainnet or personal wallet seeds.
XRPL_TESTNET_SENDER_SEED=replace-with-disposable-testnet-seed
XRPL_TESTNET_RECEIVER_SEED=replace-with-disposable-testnet-seed

# Populated after the one-time demo payment so reruns inspect instead of resubmit.
XRPL_TESTNET_PAYMENT_HASH=replace-with-validated-testnet-transaction-hash

# Populated after the separate Phase 6.3E payment. Never put a seed here.
XRPL_PHASE63_PAYMENT_HASH=replace-with-validated-phase63-transaction-hash

# Official Flare FDC testnet verifier and DA Layer access. Keep real values only
# in the gitignored .env.local file.
VERIFIER_API_KEY_TESTNET=replace-with-testnet-verifier-api-key
COSTON2_DA_LAYER_URL=replace-with-approved-da-layer-base-url
X_API_KEY=replace-with-da-layer-api-key
