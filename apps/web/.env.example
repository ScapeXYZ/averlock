NEXT_PUBLIC_AVERLOCK_INSTRUCTION_SENDER=0x530D307Cca3A01BfC9139934b3F5Fa1DA19E728D
# Optional AVERLOCK-only event history service. Dashboard/guards/vault contract reads
# still work when this is unset or the indexer is catching up.
NEXT_PUBLIC_AVERLOCK_INDEXER_URL=https://averlock-event-indexer.example.com
# Server-only FCC endpoints. Production values must be stable public HTTPS URLs,
# never localhost or a temporary tunnel. They may be the same origin when that
# origin exposes both /info and /action/result/:actionId.
AVERLOCK_FCC_PROXY_URL=https://fcc.example.com
AVERLOCK_FCC_RESULT_PROXY_URL=https://fcc.example.com
# Server-only Flare FDC verifier credential.
VERIFIER_API_KEY_TESTNET=
