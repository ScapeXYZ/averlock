# Public Coston2 network configuration. Never put wallet secrets here.
NEXT_PUBLIC_FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
# Set after DeployGuardManagerV2 reports the new deployment address.
NEXT_PUBLIC_AVERLOCK_GUARD_MANAGER=0x<new-guard-manager-address>
NEXT_PUBLIC_AVERLOCK_INSTRUCTION_SENDER=0x530D307Cca3A01BfC9139934b3F5Fa1DA19E728D
# Optional AVERLOCK-only event history service. Dashboard/guards/vault contract reads
# still work when this is unset or the indexer is catching up.
NEXT_PUBLIC_AVERLOCK_INDEXER_URL=https://averlock-event-indexer.example.com
# Server-only FCC endpoints. Production values must be stable public HTTPS URLs,
# never localhost or a temporary tunnel. They may be the same origin when that
# origin exposes both /info and /action/result/:actionId.
AVERLOCK_FCC_PROXY_URL=https://chic-essence-production.up.railway.app
AVERLOCK_FCC_RESULT_PROXY_URL=https://chic-essence-production.up.railway.app
# Server-only Flare FDC verifier credential.
VERIFIER_API_KEY_TESTNET=
NEXT_PUBLIC_AVERLOCK_PROTECTION_VAULT=0xCcF6D8A6AA0F3799f6c9c6069289D4013aABF4Eb
NEXT_PUBLIC_AVERLOCK_PRICE_READER=0xf2F2bf463b0765729189DeBe4E22dCEd601A18d5
NEXT_PUBLIC_AVERLOCK_FTEST_XRP=0x0b6A3645c240605887a5532109323A3E12273dc7
NEXT_PUBLIC_FLARE_TEE_MANAGER=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE
# Optional: when set, the verification drawer validates this current TEE onchain.
NEXT_PUBLIC_AVERLOCK_TEE_ID=0xbAd2a9e9c836efEB970b6b42A04208ee9B8D4E71
NEXT_PUBLIC_AVERLOCK_MANAGER_DEPLOYMENT_BLOCK=<new-manager-deployment-block>
# Populate these receipt-backed selectors only after the clean test succeeds.
# They must never refer to the retired guard.
NEXT_PUBLIC_AVERLOCK_RULE_ID=0x<new-rule-id>
NEXT_PUBLIC_AVERLOCK_EVENT_HASH=0x<new-event-hash>
NEXT_PUBLIC_AVERLOCK_ACTION_ID=0x<new-action-id>
NEXT_PUBLIC_AVERLOCK_POSITION_ID=<new-position-id>
NEXT_PUBLIC_AVERLOCK_REGISTRATION_BLOCK=<new-guard-registration-block>
NEXT_PUBLIC_AVERLOCK_EXECUTION_BLOCK=<new-execution-block>
# Optional public proof metadata for the verification page.
NEXT_PUBLIC_AVERLOCK_XRPL_TRANSACTION=
NEXT_PUBLIC_AVERLOCK_FDC_REQUEST_TRANSACTION=
NEXT_PUBLIC_AVERLOCK_FDC_VOTING_ROUND=
NEXT_PUBLIC_AVERLOCK_XRPL_DESTINATION=
NEXT_PUBLIC_AVERLOCK_XRPL_DELIVERED_DROPS=
