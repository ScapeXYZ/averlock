# Base Sepolia public configuration. Never put wallet secrets here.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_GUARD_MANAGER=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BASE_PROTECTION_VAULT=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BASE_APPROVED_TOKEN=0x0000000000000000000000000000000000000000
# Optional AVERLOCK-only event history service. Dashboard/guards/vault contract reads
# still work when this is unset or the indexer is catching up.
NEXT_PUBLIC_AVERLOCK_INDEXER_URL=https://averlock-base-indexer.example.com
